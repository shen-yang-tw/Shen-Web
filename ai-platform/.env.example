# 複製為 ai-platform/.env 後填入實際值（.env 已被 .gitignore 忽略，請勿提交）
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
SERVER_API_BASE_URL=http://ai-platform-backend:8000
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@<region>.pooler.supabase.com:5432/postgres
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b
TUNNEL_TOKEN=
# 開發加入 localhost；正式環境請列出實際網域
CORS_ALLOWED_ORIGINS=http://localhost:3001,https://ai-platform.example.com